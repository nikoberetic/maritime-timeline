{
  "name": "maritime-timeline",
  "version": "0.1.0",
  "description": "Timeline component based on react-calendar-timeline",
  "type": "module",
  "main": "./dist/maritime-timeline.cjs",
  "module": "./dist/maritime-timeline.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maritime-timeline.js",
      "require": "./dist/maritime-timeline.cjs"
    },
    "./styles": "./dist/maritime-timeline.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "tsc --noEmit && vite build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "dayjs": "^1.11.0",
    "maritime-ui": ">=0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.2",
    "@storybook/react-vite": "^10.5.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "dayjs": "^1.11.21",
    "maritime-ui": "0.1.74",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.82.0",
    "sass": "^1.93.3",
    "storybook": "^10.5.2",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "element-resize-detector": "^1.2.4",
    "interactjs": "^1.10.27",
    "lodash-es": "^4.17.21",
    "memoize-one": "^6.0.0"
  },
  "author": "nikoberetic",
  "license": "MIT"
}
